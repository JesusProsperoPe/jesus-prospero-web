// Configuración de Cloudflare: publica la carpeta _site que genera "npm run build"
// y un Worker pequeño solo para las rutas /api/ (verificación de aportes con Mercado Pago).
{
  "name": "jesus-prospero-web",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/acceso", "/acceso/", "/noticias/*", "/_premium/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jesus-prospero-aportes",
      "database_id": "9789ba03-8637-4403-8714-1544d5cea743",
      "migrations_dir": "migrations"
    }
  ],
  // Variables públicas (los secretos van en Cloudflare: MP_ACCESS_TOKEN, MP_WEBHOOK_SECRET, RESEND_API_KEY, GOOGLE_CLIENT_SECRET)
  "vars": {
    "GOOGLE_CLIENT_ID": "435787639140-uh85r7a0et0iht3bpcbmikjhri6cnps5.apps.googleusercontent.com"
  },
  "observability": { "enabled": true }
}
