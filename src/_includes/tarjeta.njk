<article class="tarjeta">
  <a class="tarjeta-enlace" href="{{ n.url }}">
    {% if n.data.imagen %}
    <img class="tarjeta-foto" src="{{ n.data.imagen | img(720) }}" alt="" loading="lazy">
    {% else %}
    <div class="tarjeta-foto tarjeta-sinfoto" aria-hidden="true"><span>{{ site.nombre }}</span></div>
    {% endif %}
    <p class="meta"><time datetime="{{ n.date | fechaIso }}">{{ n.date | fechaHora }}</time></p>
    <h3>{{ n.data.title }}</h3>
    {% if n.data.resumen %}<p class="tarjeta-resumen">{{ n.data.resumen }}</p>{% endif %}
  </a>
</article>
