{# Tarjeta de noticia. Antes de incluirla, define `variante`: "" (normal), "secundaria" o "destacada". #}
<article class="tarjeta{% if variante %} tarjeta-{{ variante }}{% endif %}{% if not n.data.imagen %} tarjeta-sinfoto{% endif %}">
  <a class="tarjeta-enlace" href="{{ n.url }}">
    {% if n.data.imagen %}
    <div class="foto-marco tarjeta-foto"><img src="{{ n.data.imagen | img(900) }}" alt="" loading="lazy"></div>
    {% endif %}
    <div class="tarjeta-texto">
      <p class="meta">{% if n.data.tipo %}<span class="tipo-nota">{{ n.data.tipo }}</span>{% endif %}{% if n.data.exclusivo %}<span class="sello-exclusivo">Suscriptores</span>{% endif %}<time datetime="{{ n.date | fechaIso }}">{{ n.date | fechaHora }}</time></p>
      <h3>{{ n.data.title }}</h3>
      {% if n.data.resumen and variante != "secundaria" %}<p class="tarjeta-resumen">{{ n.data.resumen }}</p>{% endif %}
    </div>
  </a>
</article>
