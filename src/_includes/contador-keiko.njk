{# Contador del gobierno de Keiko: mentiras (falsas + engañosas + contradicciones) y tiempo en el gobierno (corre en vivo).
   Antes de incluirlo, define `enPortada` (true en la portada: lleva botón a la página completa). #}
{% set casos = collections.mentiras %}
{% set falsas = casos | porCategoria("Falso") %}
{% set enganosas = casos | porCategoria("Engañoso") %}
{% set contradicciones = casos | porCategoria("Se contradijo") %}
{% set total = falsas.length + enganosas.length + contradicciones.length %}
{% set ultimo = casos[0] %}
<section class="contador" aria-labelledby="contador-titulo">
  <div class="contenedor contador-rejilla">
    <div class="contador-texto">
      <p class="contador-vivo"><span aria-hidden="true"></span>En vivo</p>
      {% if enPortada %}<h2 class="contador-titulo" id="contador-titulo">Contador de mentiras del gobierno de {{ contador.persona }}</h2>
      {% else %}<h1 class="contador-titulo" id="contador-titulo">Contador de mentiras del gobierno de {{ contador.persona }}</h1>{% endif %}
      <p class="contador-bajada">Lo que dicen la presidenta, su premier y sus ministros, contrastado con los hechos. Cada caso tiene su prueba.</p>

      <p class="contador-reloj-titulo">Tiempo en el gobierno</p>
      <div class="contador-reloj" data-inicio="{{ contador.inicio_gobierno }}" aria-live="off">
        <div><strong data-u="d">–</strong><span>Días</span></div>
        <div><strong data-u="h">–</strong><span>Horas</span></div>
        <div><strong data-u="m">–</strong><span>Minutos</span></div>
        <div><strong data-u="s">–</strong><span>Segundos</span></div>
      </div>
    </div>

    <div class="contador-numero">
      <strong>{{ total }}</strong>
      <span>{% if total == 1 %}mentira{% else %}mentiras{% endif %}</span>
    </div>

    <ul class="contador-otros" aria-label="Tipos de mentira">
      <li><strong>{{ falsas.length }}</strong> {% if falsas.length == 1 %}falsa{% else %}falsas{% endif %}</li>
      <li><strong>{{ enganosas.length }}</strong> {% if enganosas.length == 1 %}engañosa{% else %}engañosas{% endif %}</li>
      <li><strong>{{ contradicciones.length }}</strong> {% if contradicciones.length == 1 %}contradicción{% else %}contradicciones{% endif %}</li>
      {% set enRevision = (casos | porCategoria("En revisión")).length %}
      {% if enRevision %}<li><strong>{{ enRevision }}</strong> en revisión</li>{% endif %}
    </ul>

    {% if enPortada %}
    <div class="contador-pie">
      {% if ultimo %}<p class="contador-ultimo"><span>Último caso · {{ ultimo.data.quien }}</span> «{{ ultimo.data.title }}» <time datetime="{{ ultimo.date | fechaIso }}">{{ ultimo.date | fecha }}</time></p>{% endif %}
      <a class="boton" href="/contador-keiko/">Ver todos los casos y sus pruebas</a>
    </div>
    {% endif %}
  </div>
</section>
<script src="/js/contador.js" defer></script>
