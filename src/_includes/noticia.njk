---
layout: base.njk
---
<article class="nota contenedor">
  <header class="nota-cabecera">
    <p class="meta"><a href="/noticias/">Noticias</a> · <time datetime="{{ date | fechaIso }}">{{ date | fecha }}</time></p>
    <h1>{{ title }}</h1>
    {% if resumen %}<p class="nota-bajada">{{ resumen }}</p>{% endif %}
  </header>

  {% if imagen %}
  <figure class="nota-foto">
    <img src="{{ imagen | img(1400) }}" alt="{{ imagen_texto or title }}">
    {% if imagen_texto %}<figcaption>{{ imagen_texto }}</figcaption>{% endif %}
  </figure>
  {% endif %}

  <div class="nota-cuerpo">
    {{ content | safe }}
  </div>

  {% set enlace = site.url + page.url %}
  <div class="compartir" aria-label="Compartir">
    <span>Compartir:</span>
    <a href="https://wa.me/?text={{ (title + ' ' + enlace) | urlencode }}" target="_blank" rel="noopener">WhatsApp</a>
    <a href="https://www.facebook.com/sharer/sharer.php?u={{ enlace | urlencode }}" target="_blank" rel="noopener">Facebook</a>
    <a href="https://twitter.com/intent/tweet?url={{ enlace | urlencode }}&amp;text={{ title | urlencode }}" target="_blank" rel="noopener">X</a>
    <button type="button" id="copiar" data-enlace="{{ enlace }}">Copiar enlace</button>
  </div>

  {% include "apoyo.njk" %}
</article>

{% set otras = collections.noticias | otras(page.url, 3) %}
{% if otras.length %}
<section class="contenedor seccion">
  <h2 class="seccion-titulo">Más noticias</h2>
  <div class="rejilla">
    {% for n in otras %}{% include "tarjeta.njk" %}{% endfor %}
  </div>
</section>
{% endif %}

<script>
  document.getElementById("copiar").addEventListener("click", function () {
    var b = this;
    navigator.clipboard.writeText(b.dataset.enlace).then(function () {
      b.textContent = "Enlace copiado";
      setTimeout(function () { b.textContent = "Copiar enlace"; }, 2000);
    }).catch(function () { window.prompt("Copia este enlace:", b.dataset.enlace); });
  });
</script>
