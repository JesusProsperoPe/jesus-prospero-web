---
layout: base.njk
---
<article class="nota">
  <header class="contenedor nota-cabecera">
    <p class="etiqueta"><a href="/noticias/">Noticias</a></p>
    <h1>{{ title }}</h1>
    {% if resumen %}<p class="nota-bajada">{{ resumen }}</p>{% endif %}
    <div class="firma">
      <img src="{{ autor.foto }}" alt="" width="44" height="44">
      <div>
        <p class="firma-nombre">Por {{ site.nombre }}</p>
        <p class="meta"><time datetime="{{ date | fechaIso }}">{{ date | fechaHora }}</time></p>
      </div>
    </div>
  </header>

  {% if imagen %}
  <figure class="contenedor nota-foto">
    <img src="{{ imagen | img(1600) }}" alt="{{ imagen_texto or title }}">
    {% if imagen_texto or imagen_fuente %}<figcaption>{{ imagen_texto }}{% if imagen_fuente %} <span class="credito">{{ imagen_fuente }}</span>{% endif %}</figcaption>{% endif %}
  </figure>
  {% endif %}

  <div class="contenedor">
    <div class="nota-cuerpo">
      {{ content | safe }}
    </div>

    {% set enlace = site.url + page.url %}
    <div class="compartir" aria-label="Compartir">
      <span>Compartir</span>
      <a href="https://wa.me/?text={{ (title + ' ' + enlace) | urlencode }}" target="_blank" rel="noopener">WhatsApp</a>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ enlace | urlencode }}" target="_blank" rel="noopener">Facebook</a>
      <a href="https://twitter.com/intent/tweet?url={{ enlace | urlencode }}&amp;text={{ title | urlencode }}" target="_blank" rel="noopener">X</a>
      <button type="button" id="copiar" data-enlace="{{ enlace }}">Copiar enlace</button>
    </div>

    {% include "yape.njk" %}
  </div>
</article>

{% set otras = collections.noticias | otras(page.url, 3) %}
{% if otras.length %}
<section class="contenedor seccion" aria-labelledby="mas-titulo">
  <div class="seccion-cabeza">
    <h2 class="seccion-titulo" id="mas-titulo">Más noticias</h2>
    <a class="enlace-flecha" href="/noticias/">Ver todas</a>
  </div>
  <div class="rejilla">
    {% for n in otras %}{% set variante = "" %}{% include "tarjeta.njk" %}{% endfor %}
  </div>
</section>
{% endif %}

<script>
  document.getElementById("copiar").addEventListener("click", function () {
    var b = this;
    navigator.clipboard.writeText(b.dataset.enlace).then(function () {
      b.textContent = "Enlace copiado";
      setTimeout(function () { b.textContent = "Copiar enlace"; }, 2000);
    }).catch(function () { window.prompt("Copia este enlace:", b.dataset.enlace); });
  });
  var yape = document.getElementById("copiar-yape");
  if (yape) yape.addEventListener("click", function () {
    var b = this;
    navigator.clipboard.writeText(b.dataset.numero).then(function () {
      b.textContent = "Número copiado";
      setTimeout(function () { b.textContent = "Copiar número"; }, 2000);
    }).catch(function () { window.prompt("Copia este número:", b.dataset.numero); });
  });
</script>
