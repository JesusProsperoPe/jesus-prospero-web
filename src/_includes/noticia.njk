---
layout: base.njk
---
<article class="nota">
  <header class="contenedor nota-cabecera">
    <p class="etiqueta"><a href="/noticias/">Noticias</a>{% if exclusivo %}<span class="sello-exclusivo">Solo para suscriptores</span>{% endif %}</p>
    <h1>{{ title }}</h1>
    {% if resumen %}<p class="nota-bajada">{{ resumen }}</p>{% endif %}
    <div class="firma">
      <img src="{{ autor.foto }}" alt="" width="44" height="44">
      <div>
        <p class="firma-nombre">Por {{ site.nombre }}</p>
        <p class="meta"><time datetime="{{ date | fechaIso }}">{{ date | fechaHora }}</time></p>
      </div>
    </div>
  </header>

  {% if imagen %}
  <figure class="contenedor nota-foto">
    <img src="{{ imagen | img(1600) }}" alt="{{ imagen_texto or title }}">
    {% if imagen_texto or imagen_fuente %}<figcaption>{{ imagen_texto }}{% if imagen_fuente %} <span class="credito">{{ imagen_fuente }}</span>{% endif %}</figcaption>{% endif %}
  </figure>
  {% endif %}

  <div class="contenedor">
    <div class="nota-cuerpo">
      {% if exclusivo %}
      {{ content | inicioGratis | safe }}
      {# El Worker reemplaza este muro por el resto de la nota cuando lee un suscriptor #}
      <div class="muro" id="muro">
        <p class="etiqueta">Solo para suscriptores</p>
        <h2>Esta nota es exclusiva para suscriptores</h2>
        <p>Suscríbete desde {{ (aportes.planes | first).monto | solesCorto }} al mes y lee completas todas las notas exclusivas. Lo cancelas cuando quieras.</p>
        <a class="boton" href="/suscribete/" id="muro-suscribir">Suscribirme</a>
        <details class="muro-ingreso">
          <summary>¿Ya eres suscriptor? Ingresa</summary>
          <form id="muro-form">
            <label for="muro-correo">Escribe el correo con el que te suscribiste en Mercado Pago y te enviaremos un enlace para entrar.</label>
            <div class="muro-fila">
              <input type="email" id="muro-correo" name="correo" required autocomplete="email" placeholder="tucorreo@ejemplo.com">
              <button type="submit" class="boton boton-secundario">Enviar enlace</button>
            </div>
            <p class="muro-aviso" id="muro-aviso" aria-live="polite"></p>
          </form>
        </details>
      </div>
      {% else %}
      {{ content | safe }}
      {% endif %}
    </div>

    {% set enlace = site.url + page.url %}
    <div class="compartir" aria-label="Compartir">
      <span>Compartir</span>
      <a href="https://wa.me/?text={{ (title + ' ' + enlace) | urlencode }}" target="_blank" rel="noopener">WhatsApp</a>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ enlace | urlencode }}" target="_blank" rel="noopener">Facebook</a>
      <a href="https://twitter.com/intent/tweet?url={{ enlace | urlencode }}&amp;text={{ title | urlencode }}" target="_blank" rel="noopener">X</a>
      <button type="button" id="copiar" data-enlace="{{ enlace }}">Copiar enlace</button>
    </div>

    {% include "yape.njk" %}
  </div>
</article>

{% set otras = collections.noticias | otras(page.url, 3) %}
{% if otras.length %}
<section class="contenedor seccion" aria-labelledby="mas-titulo">
  <div class="seccion-cabeza">
    <h2 class="seccion-titulo" id="mas-titulo">Más noticias</h2>
    <a class="enlace-flecha" href="/noticias/">Ver todas</a>
  </div>
  <div class="rejilla">
    {% for n in otras %}{% set variante = "" %}{% include "tarjeta.njk" %}{% endfor %}
  </div>
</section>
{% endif %}

{% if exclusivo %}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": title,
  "datePublished": date | fechaIso,
  "author": { "@type": "Person", "name": site.nombre },
  "isAccessibleForFree": false,
  "hasPart": { "@type": "WebPageElement", "isAccessibleForFree": false, "cssSelector": ".nota-exclusiva" }
} | dump | safe }}
</script>
<script>
  (function () {
    var form = document.getElementById("muro-form");
    if (!form) return;
    var suscribir = document.getElementById("muro-suscribir");
    // Para volver a esta nota después de suscribirse
    suscribir.addEventListener("click", function () {
      try { localStorage.setItem("jp-volver", location.pathname); } catch (e) {}
    });
    var aviso = document.getElementById("muro-aviso");
    form.addEventListener("submit", function (ev) {
      ev.preventDefault();
      var boton = form.querySelector("button");
      boton.disabled = true;
      aviso.textContent = "Enviando…";
      fetch("/api/acceso/correo", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ correo: form.correo.value, volver: location.pathname }),
      }).then(function (r) {
        aviso.textContent = r.ok
          ? "Listo. Si ese correo tiene una suscripción activa, te llegará un enlace en unos minutos. Revisa también spam o promociones."
          : "No pudimos enviar el enlace. Escríbeme a {{ site.correo }} y te ayudo a entrar.";
      }).catch(function () {
        aviso.textContent = "No pudimos enviar el enlace. Escríbeme a {{ site.correo }} y te ayudo a entrar.";
      }).finally(function () { boton.disabled = false; });
    });
  })();
</script>
{% endif %}
<script>
  document.getElementById("copiar").addEventListener("click", function () {
    var b = this;
    navigator.clipboard.writeText(b.dataset.enlace).then(function () {
      b.textContent = "Enlace copiado";
      setTimeout(function () { b.textContent = "Copiar enlace"; }, 2000);
    }).catch(function () { window.prompt("Copia este enlace:", b.dataset.enlace); });
  });
  var yape = document.getElementById("copiar-yape");
  if (yape) yape.addEventListener("click", function () {
    var b = this;
    navigator.clipboard.writeText(b.dataset.numero).then(function () {
      b.textContent = "Número copiado";
      setTimeout(function () { b.textContent = "Copiar número"; }, 2000);
    }).catch(function () { window.prompt("Copia este número:", b.dataset.numero); });
  });
</script>
