<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if titulo_seo %}{{ titulo_seo }}{% elif title %}{{ title }} · {{ site.nombre }}{% else %}{{ site.nombre }}{% if site.lema %} · {{ site.lema }}{% endif %}{% endif %}</title>
<meta name="description" content="{{ resumen or site.descripcion }}">
<meta name="theme-color" content="#ffffff">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.nombre }}">
<meta property="og:locale" content="es_PE">
<meta property="og:type" content="{% if esNoticia %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ titulo_seo or title or site.nombre }}">
<meta property="og:description" content="{{ resumen or site.descripcion }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{# Imagen al compartir: la foto de la noticia; en las demás páginas, la foto de Jesús #}
{% if imagen %}
<meta property="og:image" content="{{ site.url }}{{ imagen }}">
<meta name="twitter:card" content="summary_large_image">
{% else %}
<meta property="og:image" content="{{ site.url }}{{ autor.foto }}">
<meta property="og:image:width" content="640">
<meta property="og:image:height" content="640">
<meta property="og:image:alt" content="{{ site.nombre }}">
<meta name="twitter:card" content="summary">
{% endif %}
<link rel="icon" href="/img/icono-48.png" type="image/png" sizes="48x48">
<link rel="icon" href="/img/icono-96.png" type="image/png" sizes="96x96">
<link rel="icon" href="/img/icono-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/img/icono-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,400..900;1,62..125,400..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap">
<link rel="stylesheet" href="/css/estilo.css">
{# Para que Google relacione la web con la persona y sus redes cuando alguien busca "Jesus Prospero" #}
{% if page.url == "/" or page.url == "/sobre-mi/" %}
{% set persona = {
  "@type": "Person",
  "@id": site.url + "/#persona",
  "name": site.nombre,
  "alternateName": ["Jesús Próspero", "Jesus Prospero Huaman"],
  "url": site.url + "/",
  "image": site.url + autor.foto,
  "jobTitle": "Comunicador político",
  "description": site.descripcion,
  "sameAs": [site.instagram, site.tiktok, site.facebook]
} %}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@graph": [
    persona,
    { "@type": "WebSite", "@id": site.url + "/#web", "name": site.nombre, "image": site.url + "/img/icono-512.png", "alternateName": "jesusprospero.pe", "url": site.url + "/", "inLanguage": "es-PE", "publisher": { "@id": site.url + "/#persona" } },
    { "@type": ("ProfilePage" if page.url == "/sobre-mi/" else "WebPage"), "url": site.url + page.url, "name": (title or site.nombre), "isPartOf": { "@id": site.url + "/#web" }, "mainEntity": { "@id": site.url + "/#persona" } }
  ]
} | dump | safe }}
</script>
{% endif %}
<meta name="google-site-verification" content="szW6kFXdRopNDHDxwuyxHy2PH_a48lUlldJ2snFbc7E">
<meta name="google-adsense-account" content="ca-pub-4024662288990496">
{# Los suscriptores leen sin anuncios: la cookie la pone el servidor cuando la suscripción está activa #}
<script>
  if (!/(?:^|;\s*)jp_sin_anuncios=1/.test(document.cookie)) {
    var ads = document.createElement("script");
    ads.async = true;
    ads.crossOrigin = "anonymous";
    ads.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4024662288990496";
    document.head.appendChild(ads);
  }
</script>
</head>
<body>
<a class="saltar" href="#contenido">Saltar al contenido</a>

<header class="cabecera">
  <div class="contenedor cabecera-fila">
    <a class="marca" href="/" aria-label="{{ site.nombre }}, ir al inicio">
      <img class="marca-foto" src="{{ autor.foto }}" alt="" width="40" height="40">
      <span class="marca-texto">
        <span class="marca-nombre">{{ site.nombre }}</span>
        {% if site.lema %}<span class="marca-lema">{{ site.lema }}</span>{% endif %}
      </span>
    </a>
    <nav class="menu" aria-label="Principal">
      <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Inicio</a>
      <a href="/noticias/"{% if page.url.startsWith("/noticias/") %} aria-current="page"{% endif %}>Noticias</a>
      <a href="/sobre-mi/"{% if page.url == "/sobre-mi/" %} aria-current="page"{% endif %}>Sobre mí</a>
    </nav>
    <a class="boton boton-secundario boton-cabecera boton-cuenta" id="menu-cuenta" href="/ingresar/"{% if page.url == "/ingresar/" or page.url == "/mi-cuenta/" %} aria-current="page"{% endif %}>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
      <span id="menu-cuenta-texto">Ingresar</span>
    </a>
    <a class="boton boton-cabecera" href="/suscribete/"{% if page.url == "/suscribete/" %} aria-current="page"{% endif %}>Suscríbete</a>
  </div>
</header>

<main id="contenido">
{{ content | safe }}
</main>

<footer class="pie">
  <div class="contenedor pie-rejilla">
    <div class="pie-marca">
      <p class="pie-nombre">{{ site.nombre }}</p>
      {% if site.lema %}<p class="pie-lema">{{ site.lema }}</p>{% endif %}
      <a class="boton" href="/suscribete/">Suscríbete</a>
    </div>
    <div>
      <p class="pie-titulo">Secciones</p>
      <ul class="pie-enlaces">
        <li><a href="/">Inicio</a></li>
        <li><a href="/noticias/">Todas las noticias</a></li>
        <li><a href="/sobre-mi/">Sobre mí</a></li>
        <li><a href="/suscribete/">Suscríbete</a></li>
        <li><a href="/mi-cuenta/">Mi cuenta</a></li>
        <li><a href="/aporte/gestionar/">Consultar o cancelar mi aporte</a></li>
        <li><a href="/contacto/">Contacto</a></li>
        <li><a href="/privacidad/">Política de privacidad</a></li>
      </ul>
    </div>
    <div>
      <p class="pie-titulo">Sígueme</p>
      <ul class="pie-enlaces">
        {% include "redes.njk" %}
      </ul>
    </div>
    <div>
      <p class="pie-titulo">Contacto</p>
      <ul class="pie-enlaces">
        <li class="pie-correo"><a href="mailto:{{ site.correo }}">{{ site.correo }}</a></li>
      </ul>
    </div>
  </div>
  <div class="contenedor"><p class="pie-legal">© {% anio %} {{ site.nombre }}. Todos los derechos reservados.</p></div>
</footer>
<script>
  // Con la sesión iniciada, la cabecera lleva a "Mi cuenta"
  (function () {
    var m = document.cookie.match(/(?:^|;\s*)jp_hola=([^;]+)/);
    if (!m) return;
    var a = document.getElementById("menu-cuenta");
    a.href = "/mi-cuenta/";
    a.setAttribute("aria-label", "Mi cuenta");
    document.getElementById("menu-cuenta-texto").textContent = "Mi cuenta";
  })();
</script>
</body>
</html>
