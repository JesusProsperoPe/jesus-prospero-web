---
layout: base.njk
title: Elige tu contraseña nueva
permalink: /cuenta/clave/
noindex: true
eleventyExcludeFromCollections: true
---
<section class="contenedor ingreso">
  <div class="ingreso-caja">
    <div class="ingreso-paso">
      <h1>Elige tu contraseña nueva</h1>
      <form id="form-clave" novalidate>
        <label class="campo"><span>Contraseña nueva</span>
          <input type="password" name="clave" required autocomplete="new-password" minlength="8">
          <small>Al menos 8 caracteres.</small>
        </label>
        <button type="submit" class="boton boton-ancho">Guardar contraseña</button>
      </form>
    </div>
    <p class="ingreso-aviso" id="ingreso-aviso" role="alert"></p>
  </div>
</section>
<script>
  (function () {
    var t = new URLSearchParams(location.search).get("t") || "";
    var aviso = document.getElementById("ingreso-aviso");
    var form = document.getElementById("form-clave");
    // El enlace no debe quedar en el historial ni pasar a otras páginas
    history.replaceState(null, "", location.pathname);
    form.addEventListener("submit", function (ev) {
      ev.preventDefault();
      if (form.clave.value.length < 8) { aviso.textContent = "La contraseña debe tener al menos 8 caracteres."; return; }
      var b = form.querySelector("button");
      b.disabled = true;
      fetch("/api/cuenta/clave", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ t: t, clave: form.clave.value }),
      }).then(function (r) { return r.json().then(function (d) { if (!r.ok) throw new Error(d.error); }); })
        .then(function () { location.replace("/mi-cuenta/"); })
        .catch(function (e) { aviso.innerHTML = ""; aviso.textContent = e.message || "Algo falló. Prueba otra vez."; })
        .finally(function () { b.disabled = false; });
    });
  })();
</script>
