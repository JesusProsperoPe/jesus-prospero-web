---
layout: base.njk
title: Sobre mí
titulo_seo: "Quién es Jesus Prospero · Sobre mí"
resumen: "Jesus Prospero, comunicador político de Huarmey, Áncash. Estudia Derecho en la USMP y escribe columnas sobre política peruana para miles de seguidores."
permalink: /sobre-mi/
eleventyExcludeFromCollections: true
---
<section class="contenedor sobre-pagina">
  <div class="sobre-pagina-rejilla">
    <img class="sobre-pagina-foto" src="{{ autor.foto }}" alt="{{ site.nombre }}" width="440" height="440">
    <div class="sobre-pagina-texto">
      <p class="etiqueta">Sobre mí</p>
      <h1 class="titulo-pagina">{{ site.nombre }}</h1>
      {% if autor.historia %}
      <div class="nota-cuerpo sobre-pagina-historia">{{ autor.historia | markdown | safe }}</div>
      {% else %}
      <p class="sobre-pagina-bio">{{ autor.bio }}</p>
      {% endif %}
      <div class="sobre-pagina-redes">
        <p class="etiqueta">Sígueme</p>
        <ul class="redes-botones">
          {% include "redes.njk" %}
        </ul>
      </div>
      <a class="boton" href="/noticias/">Leer mis noticias</a>
      {% if site.correo %}<p class="sobre-pagina-contacto">Contacto: <a href="mailto:{{ site.correo }}"><strong>{{ site.correo }}</strong></a></p>{% endif %}
    </div>
  </div>
  {% include "apoyo.njk" %}
</section>
