---
layout: base.njk
title: Noticias
pagination:
  data: collections.noticias
  size: 24
  alias: lista
  generatePageOnEmptyData: true
permalink: "/noticias/{% if pagination.pageNumber > 0 %}pagina/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<section class="contenedor seccion">
  <h1 class="titulo-pagina">Noticias</h1>
  {% if lista.length %}
  <div class="rejilla">
    {% for n in lista %}{% include "tarjeta.njk" %}{% endfor %}
  </div>
  {% else %}
  <p class="vacio">Todavía no hay noticias publicadas.</p>
  {% endif %}

  {% if pagination.pages.length > 1 %}
  <nav class="paginas" aria-label="Páginas">
    {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← Más recientes</a>{% else %}<span></span>{% endif %}
    <span>Página {{ pagination.pageNumber + 1 }} de {{ pagination.pages.length }}</span>
    {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Más antiguas →</a>{% else %}<span></span>{% endif %}
  </nav>
  {% endif %}
</section>
